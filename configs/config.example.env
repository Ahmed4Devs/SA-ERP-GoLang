# Saudi ERP Platform - Environment Configuration Template

APP_NAME=Saudi-ERP
APP_VERSION=0.1.0
APP_ENV=development
LOG_LEVEL=info

# HTTP Server
HTTP_PORT=8080
HTTP_READ_TIMEOUT=15s
HTTP_WRITE_TIMEOUT=15s
HTTP_IDLE_TIMEOUT=60s

# PostgreSQL 18 Database
DATABASE_URL=postgres://erp_user:erp_secret_password@localhost:5432/erp_dev?sslmode=disable
DB_MAX_CONNS=25
DB_MIN_CONNS=5
