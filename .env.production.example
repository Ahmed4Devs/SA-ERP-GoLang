POSTGRES_USER=erp_admin
POSTGRES_PASSWORD=replace-with-a-unique-long-password
POSTGRES_DB=erp_db
# Separate administrator, schema migration, application, and backup credentials.
ERP_MIGRATOR_PASSWORD=replace-with-a-unique-migration-password
ERP_APP_PASSWORD=replace-with-a-unique-application-password
ERP_BACKUP_PASSWORD=replace-with-a-unique-backup-database-password
# URL-encode reserved password characters in both connection URLs.
MIGRATION_DATABASE_URL=postgres://erp_migrator:replace-with-url-encoded-migration-password@postgres:5432/erp_db?sslmode=disable
DATABASE_URL=postgres://erp_app:replace-with-url-encoded-application-password@postgres:5432/erp_db?sslmode=disable
APP_URL=https://erp.example.sa
HTTP_PORT=80
HTTPS_PORT=443
TLS_CERT_PATH=/etc/erp-go/tls/fullchain.pem
TLS_KEY_PATH=/etc/erp-go/tls/privkey.pem
# Generate once with: openssl rand -base64 32
MFA_ENCRYPTION_KEY=replace-with-base64-encoded-32-byte-key
# Generate a separate random value with: openssl rand -hex 32
METRICS_BEARER_TOKEN=replace-with-a-random-64-character-token
# Generate a separate high-entropy value and load it from a secret manager in production.
BACKUP_ENCRYPTION_KEY=replace-with-a-unique-backup-encryption-key
SMTP_HOST=smtp.example.sa
SMTP_PORT=587
SMTP_USERNAME=erp-notifications
SMTP_PASSWORD=replace-with-smtp-password
SMTP_FROM=no-reply@example.sa
# Enable only for the initial installation, then disable after first login.
BOOTSTRAP_ADMIN_ENABLED=false
BOOTSTRAP_ADMIN_USERNAME=admin
BOOTSTRAP_ADMIN_EMAIL=admin@example.sa
BOOTSTRAP_ADMIN_NAME=Administrator
BOOTSTRAP_ADMIN_PASSWORD=
# Disabled by default. Enable only after formal ZATCA conformance review and
# sandbox acceptance; this acknowledgement does not itself constitute certification.
ZATCA_ENABLED=false
ZATCA_ENVIRONMENT=simulation
ZATCA_PRODUCTION_ACKNOWLEDGED=false
# Separate AES-256 key for CSID secrets/private keys; required when live ZATCA is enabled.
ZATCA_CREDENTIALS_ENCRYPTION_KEY=
# Required HTTPS endpoint when ZATCA_ENABLED=true in production.
ZATCA_BASE_URL=https://gw-fatoora.zatca.gov.sa/e-invoicing/core
# Optional OTLP/gRPC collector. Leave empty to disable trace recording/export.
OTEL_EXPORTER_OTLP_ENDPOINT=
OTEL_EXPORTER_OTLP_INSECURE=false
OTEL_TRACES_SAMPLER_RATIO=0.1

# GOSI exports are local review files. Official integration requires a verified API contract.
GOSI_INTEGRATION_MODE=file
BACKUP_RETENTION_DAYS=30
# Initialize the approved restic repository once; use separate restricted credentials.
BACKUP_REQUIRE_OFFSITE=false
RESTIC_REPOSITORY=
RESTIC_PASSWORD=
BACKUP_S3_ACCESS_KEY_ID=
BACKUP_S3_SECRET_ACCESS_KEY=
BACKUP_S3_REGION=
