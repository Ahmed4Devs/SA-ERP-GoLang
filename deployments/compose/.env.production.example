# ==============================================================================
# SAUDI ARABIA ENTERPRISE ERP - PRODUCTION ENVIRONMENT CONFIGURATION
# Copy this file to .env.production and set cryptographically secure values.
# ==============================================================================

# Application Environment & Domain
APP_ENV=production
APP_URL=https://erp.example.sa
APP_PORT=8080

# Timezone (Mandatory Asia/Riyadh for ZATCA & Saudi Labor Law WPS timestamps)
TZ=Asia/Riyadh

# ------------------------------------------------------------------------------
# PostgreSQL 18 Database Configuration
# ------------------------------------------------------------------------------
POSTGRES_USER=erp_admin
POSTGRES_PASSWORD=SetAStrongPasswordHere_Min24Characters_Random!
POSTGRES_DB=erp_production
POSTGRES_PORT=5432
DATABASE_URL=postgres://${POSTGRES_USER}:${POSTGRES_PASSWORD}@postgres:5432/${POSTGRES_DB}?sslmode=disable&pool_max_conns=50&pool_min_conns=10

# ------------------------------------------------------------------------------
# Redis 7 In-Memory & Queue Configuration
# ------------------------------------------------------------------------------
REDIS_PASSWORD=SetAStrongRedisPasswordHere_Min24Characters!
REDIS_PORT=6379
REDIS_URL=redis://:${REDIS_PASSWORD}@redis:6379/0

# ------------------------------------------------------------------------------
# Security & Cryptographic Secrets
# Generate using: openssl rand -hex 32
# ------------------------------------------------------------------------------
SESSION_SECRET=a8f5c3b29014e7a8df4192bce892305a764d2e8b1c09543e2f1a67890b4cd1ef
JWT_SECRET=4b6e8a01c9d2e3f45a6b7c8d9e0f1a2b3c4d5e6f7a8b9c0d1e2f3a4b5c6d7e8f
CSRF_SECRET=7f8e9d0a1b2c3d4e5f6a7b8c9d0e1f2a3b4c5d6e7f8a9b0c1d2e3f4a5b6c7d8e
ENCRYPTION_KEY=9a8b7c6d5e4f3a2b1c0d9e8f7a6b5c4d3e2f1a0b9c8d7e6f5a4b3c2d1e0f9a8b

# ------------------------------------------------------------------------------
# CORS & Web Origins
# ------------------------------------------------------------------------------
CORS_ALLOWED_ORIGINS=https://erp.example.sa,https://app.erp.example.sa

# ------------------------------------------------------------------------------
# ZATCA Phase 2 E-Invoicing Production Integration
# ------------------------------------------------------------------------------
ZATCA_ENVIRONMENT=simulation # Options: sandbox, simulation, production
ZATCA_CSID_SECRET=ReplaceWithProductionZatcaCSIDSecret
ZATCA_PRIVATE_KEY_PATH=/etc/ssl/certs/zatca_private.pem
ZATCA_COMPLIANCE_REQUEST_ID=

# ------------------------------------------------------------------------------
# Telemetry & Monitoring
# ------------------------------------------------------------------------------
METRICS_PORT=9090
LOG_LEVEL=info # debug, info, warn, error
LOG_FORMAT=json
NEXT_TELEMETRY_DISABLED=1
