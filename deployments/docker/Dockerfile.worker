# Multi-stage Production Dockerfile for Saudi ERP Background Worker
FROM golang:1.27.1-alpine AS builder

WORKDIR /src

RUN apk add --no-cache git ca-certificates tzdata

COPY go.mod go.sum ./
RUN go mod download

COPY . .

RUN CGO_ENABLED=0 GOOS=linux go build \
    -ldflags="-w -s -X main.version=v1.0.0" \
    -o /bin/erp-worker ./cmd/erp-worker

FROM alpine:3.21

RUN apk --no-cache add ca-certificates tzdata && \
    addgroup -S appgroup && adduser -S appuser -G appgroup

WORKDIR /app

ENV TZ=Asia/Riyadh

COPY --from=builder /bin/erp-worker /app/erp-worker

USER appuser

ENTRYPOINT ["/app/erp-worker"]
