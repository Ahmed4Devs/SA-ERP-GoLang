# Multi-stage Production Dockerfile for Saudi ERP API Core
# Stage 1: Build binary
FROM golang:1.27.1-alpine AS builder

WORKDIR /src

RUN apk add --no-cache git ca-certificates tzdata

COPY go.mod go.sum ./
RUN go mod download

COPY . .

RUN CGO_ENABLED=0 GOOS=linux go build \
    -ldflags="-w -s -X main.version=v1.0.0" \
    -o /bin/erp-api ./cmd/erp-api

# Stage 2: Minimal hardened runtime image
FROM alpine:3.21

RUN apk --no-cache add ca-certificates tzdata curl && \
    addgroup -S appgroup && adduser -S appuser -G appgroup

WORKDIR /app

# Set default timezone for Saudi Arabia
ENV TZ=Asia/Riyadh

COPY --from=builder /bin/erp-api /app/erp-api
COPY --from=builder /src/database/migrations /app/database/migrations
RUN mkdir -p /app/data/storage && chown -R appuser:appgroup /app/data

USER appuser

EXPOSE 8080

HEALTHCHECK --interval=15s --timeout=5s --start-period=10s --retries=3 \
	CMD curl -f http://localhost:8080/readyz || exit 1

ENTRYPOINT ["/app/erp-api"]
