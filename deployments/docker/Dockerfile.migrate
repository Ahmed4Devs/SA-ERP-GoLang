# Production Schema Migration Runner Container
FROM golang:1.27.1-alpine AS builder

WORKDIR /src
COPY go.mod go.sum ./
RUN go mod download
COPY . .
RUN CGO_ENABLED=0 GOOS=linux go build -trimpath -ldflags="-w -s" -o /bin/erp-migrate ./cmd/erp-migrate

FROM alpine:3.21

RUN apk --no-cache upgrade && \
    apk --no-cache add ca-certificates tzdata && \
    addgroup -S migrategroup && adduser -S migrateuser -G migrategroup

WORKDIR /migrations

COPY --from=builder /bin/erp-migrate /usr/local/bin/erp-migrate
COPY database/migrations /migrations/sql

ENV GOOSE_DRIVER=postgres
ENV GOOSE_MIGRATION_DIR=/migrations/sql

USER migrateuser

ENTRYPOINT ["erp-migrate"]
CMD ["up"]
