# Development only. Docker Compose reads this file after copying it to .env.
# Native Go commands read environment variables, not .env files; see local-setup.md.
APP_ENV=development
APP_NAME=Saudi-ERP
APP_VERSION=1.0.0
LOG_LEVEL=info
POSTGRES_USER=erp_user
POSTGRES_PASSWORD=erp_secret_password
POSTGRES_DB=erp_dev
POSTGRES_PORT=5432
DATABASE_URL=postgres://erp_user:erp_secret_password@localhost:5432/erp_dev?sslmode=disable
DB_MAX_CONNS=25
DB_MIN_CONNS=5
HTTP_PORT=8080
API_PORT=8080
WEB_PORT=3000
NEXT_PUBLIC_API_URL=http://localhost:8080
CORS_ALLOWED_ORIGINS=http://localhost:3000,http://127.0.0.1:3000
MFA_ENCRYPTION_KEY=AAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAA=
BOOTSTRAP_ADMIN_ENABLED=true
BOOTSTRAP_DEMO_DATA_ENABLED=true
BOOTSTRAP_ADMIN_USERNAME=admin
BOOTSTRAP_ADMIN_EMAIL=admin@erp.sa
BOOTSTRAP_ADMIN_PASSWORD=Admin@ERP123!
STORAGE_PROVIDER=local
STORAGE_LOCAL_DIR=./data/storage
MAIL_DRIVER=mock
SMTP_HOST=
SMTP_PORT=587
SMTP_USERNAME=
SMTP_PASSWORD=
SMTP_FROM=
ZATCA_ENABLED=true
ZATCA_ENVIRONMENT=simulation
ZATCA_BASE_URL=
ZATCA_CREDENTIALS_ENCRYPTION_KEY=
OTEL_EXPORTER_OTLP_ENDPOINT=
OTEL_EXPORTER_OTLP_INSECURE=false
OTEL_TRACES_SAMPLER_RATIO=0.1

# manual, file (default), or non-production simulation; official fails closed.
GOSI_INTEGRATION_MODE=file
